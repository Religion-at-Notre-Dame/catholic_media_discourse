# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# OpenRouter — TypeSafe Jev (informal-learning multi-label + accuracy judge)
# Create a key: https://openrouter.ai/settings/keys
# Docs: https://openrouter.ai/docs/guides/community/jev
# Decisions API: POST https://openrouter.ai/api/alpha/decisions
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
# Pin a release for reproducible thresholds; or use ~typesafe/jev-latest
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# -----------------------------------------------------------------------------
# Spotify Web API (required for scripts/get/spotify.py)
# Create an app at https://developer.spotify.com/dashboard
# Uses Client Credentials flow — no user login needed.
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# -----------------------------------------------------------------------------
# YouTube Data API v3 (required for scripts/get/youtube.py)
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3"
# 3. Create an API key under APIs & Services → Credentials
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key

# -----------------------------------------------------------------------------
# Google Programmable Search (required for scripts/get/google_search.py)
# 1. https://programmablesearchengine.google.com/ → create engine → copy Search engine ID
# 2. Google Cloud → enable "Custom Search API" (can reuse YOUTUBE_API_KEY above)
# -----------------------------------------------------------------------------
GOOGLE_CSE_ID=your_search_engine_id
# Optional if same key as YouTube; otherwise set separately:
# GOOGLE_CSE_API_KEY=your_google_api_key

# -----------------------------------------------------------------------------
# CARTO basemap (Explore map tiles)
# Free key: https://carto.com/basemaps/apikey/
# viz/serve.py writes this into viz/js/basemap-key.js (gitignored) at startup.
# -----------------------------------------------------------------------------
CARTO_BASEMAP_KEY=

# -----------------------------------------------------------------------------
# Pending collectors (not yet run — safe to leave as placeholders)
# Once configured, run:  bash scripts/run_pending_collectors.sh
#   Spotify  → data/americas/spotify/
#   Google   → data/us/google_search/
# -----------------------------------------------------------------------------
